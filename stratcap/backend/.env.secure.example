# Secure Environment Configuration Template for StratCap
# 
# SECURITY NOTICE: 
# - Never commit actual secrets to version control
# - Use a secrets management service in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# - All secret values should be randomly generated and unique per environment
# - Rotate secrets regularly according to your security policy

# Application Environment
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stratcap_db
DB_USER=stratcap_user
# Generate with: openssl rand -base64 32
DB_PASSWORD=<GENERATE_SECURE_PASSWORD>

# JWT Authentication Secrets
# Generate with: openssl rand -hex 64
JWT_SECRET=<GENERATE_64_BYTE_HEX_STRING>
JWT_EXPIRES_IN=7d
# Generate with: openssl rand -hex 64
JWT_REFRESH_SECRET=<GENERATE_64_BYTE_HEX_STRING>
JWT_REFRESH_EXPIRES_IN=30d

# Session Management
# Generate with: openssl rand -hex 32
SESSION_SECRET=<GENERATE_32_BYTE_HEX_STRING>

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
# Use app-specific password or OAuth2
SMTP_PASS=<APP_SPECIFIC_PASSWORD>
EMAIL_FROM=noreply@stratcap.com

# Frontend Configuration
FRONTEND_URL=https://your-domain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# MFA Configuration
MFA_APP_NAME=StratCap

# Field-Level Encryption
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX_STRING>

# Master Encryption Key (for secrets encryption)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX_STRING>

# AWS Configuration (if using AWS Secrets Manager)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_KEY>

# HashiCorp Vault Configuration (if using Vault)
# VAULT_ADDR=https://vault.your-domain.com
# VAULT_TOKEN=<YOUR_VAULT_TOKEN>
# VAULT_PATH=secret/data/stratcap

# Security Headers Configuration
HSTS_MAX_AGE=31536000
CSP_REPORT_URI=https://your-domain.com/csp-report

# Monitoring and Alerting
SENTRY_DSN=<YOUR_SENTRY_DSN>
DATADOG_API_KEY=<YOUR_DATADOG_KEY>

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Database Encryption at Rest
# Enable Transparent Data Encryption (TDE) in PostgreSQL
# POSTGRES_ENCRYPTION_KEY=<GENERATE_SECURE_KEY>

# Backup Encryption
BACKUP_ENCRYPTION_KEY=<GENERATE_SECURE_KEY>

# Secret Rotation Schedule (days)
SECRET_ROTATION_JWT=90
SECRET_ROTATION_SESSION=365
SECRET_ROTATION_ENCRYPTION=180
SECRET_ROTATION_DATABASE=60

# Compliance Configuration
ENABLE_AUDIT_LOGGING=true
ENABLE_GDPR_FEATURES=true
ENABLE_SOX_COMPLIANCE=true

# Performance Configuration
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_IDLE_TIMEOUT=30000

# Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_FUND_DATA=1800
CACHE_TTL_PERFORMANCE_METRICS=3600
CACHE_TTL_USER_SESSION=7200

# Script to generate all secrets:
# #!/bin/bash
# echo "DB_PASSWORD=$(openssl rand -base64 32)"
# echo "JWT_SECRET=$(openssl rand -hex 64)"
# echo "JWT_REFRESH_SECRET=$(openssl rand -hex 64)"
# echo "SESSION_SECRET=$(openssl rand -hex 32)"
# echo "FIELD_ENCRYPTION_KEY=$(openssl rand -hex 32)"
# echo "MASTER_ENCRYPTION_KEY=$(openssl rand -hex 32)"
# echo "REDIS_PASSWORD=$(openssl rand -base64 32)"
# echo "BACKUP_ENCRYPTION_KEY=$(openssl rand -hex 32)"